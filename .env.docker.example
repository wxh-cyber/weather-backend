DATABASE_URL="mysql://root:123456@mysql:3306/weather_backend"
PORT=3000
APP_HOST_PORT=3001
JWT_ACCESS_SECRET="replace-with-access-secret"
JWT_REFRESH_SECRET="replace-with-refresh-secret"
ACCESS_TOKEN_EXPIRES_IN="2h"
REFRESH_TOKEN_EXPIRES_IN="7d"
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_GEOCODING_PROVIDER="gaode"
WEATHER_GEOCODING_BASE_URL="https://geocoding-api.open-meteo.com/v1/search"
WEATHER_GEOCODING_GAODE_BASE_URL="https://restapi.amap.com/v3/geocode/geo"
WEATHER_GEOCODING_API_KEY=""
WEATHER_GEOCODING_TIMEOUT_MS=2500
WEATHER_REVERSE_GEOCODING_PROVIDER="gaode"
WEATHER_REVERSE_GEOCODING_BASE_URL="https://restapi.amap.com/v3/geocode/regeo"
WEATHER_REVERSE_GEOCODING_API_KEY=""
WEATHER_REVERSE_GEOCODING_FALLBACK_BASE_URL="https://nominatim.openstreetmap.org/reverse"
WEATHER_REVERSE_GEOCODING_USER_AGENT="weather-backend/1.0"
WEATHER_REVERSE_GEOCODING_TIMEOUT_MS=2500
WEATHER_API_KEY=""
WEATHER_TIMEZONE="Asia/Shanghai"
WEATHER_CACHE_MINUTES=30
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
UPLOAD_ROOT="uploads"
LOGIN_GEO_LOOKUP_ENABLED="true"
LOGIN_GEO_LOOKUP_BASE_URL="https://geo.example.com/lookup?ip={ip}"
LOGIN_GEO_LOOKUP_API_KEY=""
LOGIN_GEO_LOOKUP_TIMEOUT_MS=1500

# Docker Compose / MySQL bootstrap settings
MYSQL_DATABASE=weather_backend
MYSQL_ROOT_PASSWORD=123456
