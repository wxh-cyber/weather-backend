generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userId         String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  nickname       String?
  phone          String        @default("")
  qq             String        @default("")
  wechat         String        @default("")
  avatarUrl      String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  loginRecords   LoginRecord[]
  refreshTokens  RefreshToken[]
  userCities     UserCity[]
}

model LoginRecord {
  recordId       String   @id @default(cuid())
  account        String
  loginTime      DateTime @default(now())
  loginAddress   String
  loginDevice    String
  userId         String
  user           User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, loginTime(sort: Desc)])
}

model RefreshToken {
  tokenId      String    @id
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  userId       String
  user         User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model City {
  cityId           String            @id @default(cuid())
  cityName         String            @unique
  cityCode         String?           @unique
  province         String            @default("")
  country          String            @default("中国")
  latitude         Float?
  longitude        Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userCities       UserCity[]
  weatherSnapshots WeatherSnapshot[]
}

model UserCity {
  userCityId String   @id @default(cuid())
  userId     String
  cityId     String
  sortOrder  Int      @default(0)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  city       City     @relation(fields: [cityId], references: [cityId], onDelete: Cascade)

  @@unique([userId, cityId])
  @@index([userId, isDefault])
}

model WeatherSnapshot {
  snapshotId   String   @id @default(cuid())
  cityId       String
  source       String
  weatherText  String
  temperature  String
  currentJson  Json
  hourlyJson   Json
  dailyJson    Json
  fetchedAt    DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  city         City     @relation(fields: [cityId], references: [cityId], onDelete: Cascade)

  @@unique([cityId, source])
}
